#!/bin/bash

echo "🔍 Tjekker og opdaterer synkronisering..."
echo ""

sync_repo() {
    local dir="$1"
    local name="$2"

    if [ -d "$dir" ]; then
        echo "--- $name ---"
        cd "$dir" || return
        
        # Gem lokale ændringer (hvis nogen)
        if [ -n "$(git status --porcelain)" ]; then
            echo "📤 Gemmer og uploader lokale ændringer..."
            git add .
            git commit -m "Auto-sync fra $(hostname) - $(date '+%Y-%m-%d %H:%M')"
        fi

        # Hent ændringer fra GitHub (med rebase for at undgå konflikter)
        echo "📥 Henter seneste fra GitHub..."
        if ! git pull --rebase origin main 2>/dev/null; then
            echo "⚠️  Kunne ikke rebase - forsøger merge i stedet..."
            git pull origin main --no-rebase
        fi

        # Push til GitHub
        echo "📤 Sender til GitHub..."
        git push origin main
        
        echo "--- Seneste commits ---"
        git log --oneline | head -3
    else
        echo "❌ Mappe ikke fundet: $dir"
    fi
    echo ""
}

# ============================================
# 1. Scripts (værktøjer)
# ============================================
sync_repo "$HOME/projects/scripts" "Scripts"

# ============================================
# 2. Problembasen
# ============================================
sync_repo "$HOME/projects/problembasen" "Problembasen"

# Hent .env fra server
if [ -d "$HOME/projects/problembasen" ]; then
    echo "📥 Henter .env fra server..."
    scp hjbjrg.com@ssh.simply.com:/var/www/hjbjrg.com/public_html/problembase/.env "$HOME/projects/problembasen/.env"
    echo "---"
    grep "ENCRYPTION_KEY" "$HOME/projects/problembasen/.env" 2>/dev/null || echo "Ingen ENCRYPTION_KEY i .env"
    echo ""
fi

# ============================================
# 3. Birdbase
# ============================================
sync_repo "$HOME/projects/birdbase" "Birdbase"

# ============================================
# 4. Opdater serveren
# ============================================
echo "🌐 Opdaterer serveren..."
echo ""

if [ -d "$HOME/projects/birdbase" ]; then
    echo "--- Birdbase på server ---"
    ssh hjbjrg.com@ssh.simply.com "cd /var/www/hjbjrg.com/public_html/birdbase && git pull origin main"
    echo ""
fi

if [ -d "$HOME/projects/problembasen" ]; then
    echo "--- Problembasen på server ---"
    ssh hjbjrg.com@ssh.simply.com "cd /var/www/hjbjrg.com/public_html/problembase && git pull origin main"
    echo ""
fi

echo "✅ Synkronisering færdig."
