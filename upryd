#!/bin/bash

# ============================================
# UPRYD - Komplet opdatering til Linux Mint
# ============================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
NC='\033[0m'

if [ "$EUID" -eq 0 ]; then 
    echo -e "${RED}Advarsel: Kører som root - det anbefales ikke!${NC}"
    echo -e "${YELLOW}Brug i stedet: upryd (uden sudo)${NC}"
    exit 1
fi

clear
echo -e "${PURPLE}========================================${NC}"
echo -e "${PURPLE}     🍃 UPRYD - Linux Mint${NC}"
echo -e "${PURPLE}========================================${NC}"
echo -e "${BLUE}Start: $(date)${NC}\n"

echo -e "${YELLOW}[1/6] Opdaterer pakkelister...${NC}"
sudo apt update -qq

echo -e "\n${YELLOW}[2/6] Opgraderer pakker...${NC}"
sudo apt upgrade -y

echo -e "\n${YELLOW}[3/6] Opgraderer distribution...${NC}"
sudo apt dist-upgrade -y

echo -e "\n${YELLOW}[4/6] Opdaterer Flatpak-pakker...${NC}"
if command -v flatpak &> /dev/null; then
    echo -e "${GREEN}✅ Flatpak fundet - opdaterer...${NC}"
    flatpak update -y
    echo -e "\n${GREEN}Fjerner ubrugte Flatpak-pakker...${NC}"
    flatpak uninstall --unused -y
else
    echo -e "${RED}❌ Flatpak ikke installeret - springer over${NC}"
fi

echo -e "\n${YELLOW}[5/6] Tjekker Snap...${NC}"
if command -v snap &> /dev/null; then
    echo -e "${GREEN}✅ Snap fundet - opdaterer...${NC}"
    sudo snap refresh
else
    echo -e "${RED}❌ Snap ikke installeret - springer over${NC}"
fi

echo -e "\n${YELLOW}[6/6] Rydder op i systemet, cache og gamle kernels...${NC}"
sudo apt autoremove --purge -y
sudo apt autoclean -y
sudo apt clean -y
sudo journalctl --vacuum-time=3d 2>/dev/null || true

echo -e "\n${PURPLE}========================================${NC}"
echo -e "${GREEN}✅ UPRYD - Færdig!${NC}"
echo -e "${PURPLE}========================================${NC}"
echo -e "${BLUE}Slut: $(date)${NC}\n"

echo -e "${YELLOW}📊 Systemstatus:${NC}"
echo -e "${BLUE}➜ OS:${NC} $(lsb_release -ds 2>/dev/null || echo "Linux Mint")"
echo -e "${BLUE}➜ Kernel:${NC} $(uname -r)"
echo -e "${BLUE}➜ Uptime:${NC} $(uptime -p | sed 's/up //')"
echo -e "${BLUE}➜ Diskplads:${NC}"
df -h / | awk 'NR==2 {print "  Brugt: " $3 " / " $2 " (" $5 ")"}'

echo -e "\n${GREEN}Tryk Enter for at afslutte...${NC}"
read
