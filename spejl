#!/bin/bash

# ============================================
# SPEJL - Finder det hurtigste softwarespejl
# ============================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
NC='\033[0m'

clear
echo -e "${PURPLE}========================================${NC}"
echo -e "${PURPLE}      🚀 SPEJL - Finder det hurtigste${NC}"
echo -e "${PURPLE}========================================${NC}"
echo -e "${BLUE}Start: $(date)${NC}\n"

# ============================================
# 1. Installer værktøjer (hvis nødvendigt)
# ============================================
echo -e "${YELLOW}[1/3] Tjekker værktøjer...${NC}"

# Tjek om pipx er installeret
if ! command -v pipx &> /dev/null; then
    echo -e "${BLUE}➜ Installerer pipx...${NC}"
    sudo apt update -qq
    sudo apt install pipx -y
    pipx ensurepath
fi

# Tjek om apt-select er installeret
if ! pipx list 2>/dev/null | grep -q apt-select; then
    echo -e "${BLUE}➜ Installerer apt-select via pipx...${NC}"
    pipx install apt-select
fi

echo -e "${GREEN}✅ Værktøjer klar!${NC}\n"

# ============================================
# 2. Find det hurtigste spejl
# ============================================
echo -e "${YELLOW}[2/3] Finder det hurtigste spejl...${NC}"
echo -e "${BLUE}➜ Tester spejle (dette kan tage et øjeblik)...${NC}"

~/.local/bin/apt-select --choose

echo -e "${GREEN}✅ Spejl valgt!${NC}\n"

# ============================================
# 3. Opdater pakkelister
# ============================================
echo -e "${YELLOW}[3/3] Opdaterer pakkelister...${NC}"
sudo apt update

echo -e "\n${GREEN}========================================${NC}"
echo -e "${GREEN}✅ Færdig!${NC}"
echo -e "${GREEN}========================================${NC}"
echo -e "${BLUE}Slut: $(date)${NC}"
